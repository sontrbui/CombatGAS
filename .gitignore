# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
/CombatGAS/Binaries/*
/CombatGAS/Plugins/**/Binaries/*

# Builds
/CombatGAS/Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!/CombatGAS/Build/*/
/CombatGAS/Build/*/**
!/CombatGAS/Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
/CombatGAS/Saved/*

# Compiled source files for the engine to use
/CombatGAS/Intermediate/*
/CombatGAS/Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*
/CombatGAS/Saved/webcache_6613
/CombatGAS/Content/Sabertooth
/CombatGAS/Saved/Logs
/CombatGAS/Content/NiagaraExamples
/CombatGAS/Config/DefaultEditor.ini
/CombatGAS/Config/DefaultEngine.ini
/CombatGAS/Intermediate
